# Copie ce fichier sous le nom .env, puis colle ta clé après le signe =
# Le fichier .env reste sur ton ordinateur : il est exclu de Git par .gitignore.

GEMINI_API_KEY=

# Optionnel : Claude (API payante)
# ANTHROPIC_API_KEY=

# Optionnel : réglages
# AGENT_PROVIDER=gemini
# GEMINI_MODEL=gemini-flash-latest   (ou un modèle figé, par exemple gemini-3.8-flash)
# CLAUDE_MODEL=claude-haiku-5-5
# AGENT_PAUSE=4

# Optionnel : Alfred
# Prénom du maître de cet ordinateur (Alfred le demande aussi au premier lancement) :
# ALFRED_MAITRE=Smail
# Voix du Mac pour la salutation au démarrage, ou off pour la couper :
# ALFRED_VOIX=Thomas
